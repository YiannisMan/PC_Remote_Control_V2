<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".PcListActivity">

    <LinearLayout
        android:id="@+id/idTop"
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="80dp"
        android:background="#EAECF5">

        <TextView
            android:id="@+id/idTitle"
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            android:text="@string/Title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/idTopButtonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/idTop"
        app:layout_constraintBottom_toTopOf="@id/idRVCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="#EAECF5">

        <Button
            android:id="@+id/buttonSelectAll"
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:layout_height="wrap_content"
            app:backgroundTint="#9b8afB"
            android:text="@string/SelectAll"
            android:textSize="12sp"
            app:cornerRadius="20dp"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="15dp"
            android:singleLine="true"
            android:ellipsize="end"/>

        <Button
            android:id="@+id/buttonDeselect"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            app:backgroundTint="#9b8afB"
            android:text="@string/Deselect"
            android:textSize="12sp"
            app:cornerRadius="20dp"
            android:layout_marginEnd="10dp"/>

        <Button
            android:id="@+id/buttonRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="22dp"
            android:layout_weight="1"
            android:text="@string/Refresh"
            android:textSize="12sp"
            app:backgroundTint="#9b8afB"
            app:cornerRadius="20dp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/idRVCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/idTopButtonLayout"
        app:layout_constraintBottom_toTopOf="@id/idScrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"/>

    <ScrollView
        android:id="@+id/idScrollView"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintTop_toBottomOf="@id/idRVCard"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="#FAFAFA">

        <TextView
            android:id="@+id/idEchoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:textSize="15sp"
            android:text="@string/Console"/>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomButtonsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#EAECF5"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/buttonBack"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            app:backgroundTint="#9b8afB"
            android:text="@string/Back"
            app:cornerRadius="20dp"
            android:layout_marginEnd="22dp"/>

        <Button
            android:id="@+id/buttonContinue"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            app:backgroundTint="#9b8afB"
            android:text="@string/Continue"
            app:cornerRadius="20dp"
            android:layout_marginStart="22dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>